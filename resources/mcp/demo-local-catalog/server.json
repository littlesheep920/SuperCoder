      "SUPERCODER_CATALOG_NETWORK": "disabled"
    },
    "startup_timeout_seconds": 10,
    "shutdown_timeout_seconds": 5
  },
  "implementation": {
    "module": "supercoder_demo_local_catalog_mcp",
    "status": "not-implemented",
    "required_protocol": "MCP stdio",
    "notes": "This Stage 0 file freezes a concrete launch contract only. A later implementation must provide the module and pass protocol, sandbox, permission, and runtime-adapter validation before execution."
  }
}
