# SuperCoder local configuration template.
# Copy to a local, ignored environment file and override only what is needed.
# Never commit real credentials. Empty *_PASSWORD, *_TOKEN, and *_API_KEY values
# are deliberate placeholders. External model calls are disabled by default.

# Development auth tokens: the server reads a token registry from this path.
# The registry is git-ignored. Create it once before the first local run:
#   Copy-Item scripts/dev_tokens.example.json scripts/dev_tokens.json
# Pinned dependencies for the API and worker: requirements-stage1.txt
SUPERCODER_DEV_AUTH_TOKENS_FILE=scripts/dev_tokens.json

SUPERCODER_CONFIG_SCHEMA_VERSION=1
SUPERCODER_ENVIRONMENT=local

# Git: local and read-only by default; no network synchronization.
SUPERCODER_GIT_ENABLED=true
SUPERCODER_GIT_REPOSITORY_ROOT=.
SUPERCODER_GIT_DEFAULT_BRANCH=main
SUPERCODER_GIT_REMOTE_NAME=origin
SUPERCODER_GIT_REMOTE_URL=
SUPERCODER_GIT_SYNC_ENABLED=false
# Read-only by default. The registration commit endpoint refuses with 503 while
# this is true, which is the safe default: an unexpected write would land in the
# operator's working tree. Set false only to exercise that path deliberately, and
# switch back afterwards.
SUPERCODER_GIT_READ_ONLY=true
SUPERCODER_GIT_TOKEN=

# MySQL: local placeholder; connection remains disabled until explicitly enabled.
SUPERCODER_MYSQL_ENABLED=false
SUPERCODER_MYSQL_HOST=127.0.0.1
SUPERCODER_MYSQL_PORT=3306
SUPERCODER_MYSQL_DATABASE=supercoder
SUPERCODER_MYSQL_USER=supercoder_local
SUPERCODER_MYSQL_PASSWORD=
SUPERCODER_MYSQL_SSL_MODE=disabled
SUPERCODER_MYSQL_CONNECT_TIMEOUT_SECONDS=5
SUPERCODER_MYSQL_POOL_SIZE=5
SUPERCODER_MYSQL_MAX_OVERFLOW=5

# Redis: optional local queue/cache; disabled by default.
SUPERCODER_REDIS_ENABLED=false
SUPERCODER_REDIS_HOST=127.0.0.1
SUPERCODER_REDIS_PORT=6379
SUPERCODER_REDIS_DATABASE=0
SUPERCODER_REDIS_USERNAME=
SUPERCODER_REDIS_PASSWORD=
SUPERCODER_REDIS_TLS_ENABLED=false
SUPERCODER_REDIS_CONNECT_TIMEOUT_SECONDS=5
SUPERCODER_REDIS_KEY_PREFIX=supercoder:local:

# Qdrant: optional local vector projection; disabled by default.
SUPERCODER_QDRANT_ENABLED=false
SUPERCODER_QDRANT_URL=http://127.0.0.1:6333
SUPERCODER_QDRANT_COLLECTION_PREFIX=supercoder_local
SUPERCODER_QDRANT_API_KEY=
SUPERCODER_QDRANT_TLS_VERIFY=true
SUPERCODER_QDRANT_REQUEST_TIMEOUT_SECONDS=10

# Embedding: no model is loaded and no request is sent by default.
# Valid providers after opt-in: local, openai_compatible.
SUPERCODER_EMBEDDING_ENABLED=false
SUPERCODER_EMBEDDING_PROVIDER=disabled
SUPERCODER_EMBEDDING_MODEL=
SUPERCODER_EMBEDDING_BASE_URL=
SUPERCODER_EMBEDDING_API_KEY=
SUPERCODER_EMBEDDING_ALLOW_REMOTE=false
SUPERCODER_EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
SUPERCODER_EMBEDDING_BATCH_SIZE=16

# Rerank: no model is loaded and no request is sent by default.
# Valid providers after opt-in: local, openai_compatible.
SUPERCODER_RERANK_ENABLED=false
SUPERCODER_RERANK_PROVIDER=disabled
SUPERCODER_RERANK_MODEL=
SUPERCODER_RERANK_BASE_URL=
SUPERCODER_RERANK_API_KEY=
SUPERCODER_RERANK_ALLOW_REMOTE=false
SUPERCODER_RERANK_REQUEST_TIMEOUT_SECONDS=30
SUPERCODER_RERANK_BATCH_SIZE=16

# Search: Stage 2 retrieval pipeline.
# Both providers are disabled by default; while disabled no request is made and
# the API key below is never read. Model names are configuration, not code.
#
# To enable real semantic retrieval, set all three flags true and inject the key
# from your shell or a secret manager. NEVER commit the key value.
#   SUPERCODER_SEARCH_REMOTE_ENABLED=true
#   SUPERCODER_EMBEDDING_ENABLED=true
#   SUPERCODER_RERANK_ENABLED=true
SUPERCODER_SEARCH_REMOTE_ENABLED=false
SUPERCODER_SEARCH_BASE_URL=https://api.siliconflow.cn/v1
SUPERCODER_SEARCH_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
SUPERCODER_SEARCH_EMBEDDING_DIMENSIONS=1024
SUPERCODER_SEARCH_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SUPERCODER_SEARCH_TIMEOUT_SECONDS=30
SUPERCODER_SEARCH_BATCH_SIZE=16
SUPERCODER_SEARCH_API_KEY=

# Docker execution: no daemon access, image, or network by default.
SUPERCODER_DOCKER_ENABLED=false
SUPERCODER_DOCKER_SOCKET_URI=
SUPERCODER_DOCKER_IMAGE_ALLOWLIST=
SUPERCODER_DOCKER_NETWORK_MODE=none
SUPERCODER_DOCKER_READ_ONLY_ROOT_FILESYSTEM=true
SUPERCODER_DOCKER_NO_NEW_PRIVILEGES=true
SUPERCODER_DOCKER_CPU_LIMIT=1
SUPERCODER_DOCKER_MEMORY_LIMIT_MB=512
SUPERCODER_DOCKER_PIDS_LIMIT=256
SUPERCODER_DOCKER_EXECUTION_TIMEOUT_SECONDS=300

# External OpenAI-compatible LLM: two explicit gates remain false.
# Enabling access still requires a reviewed base URL/model and locally injected key.
#
# This drives the capability-discovery judge and the manifest drafter. The search
# pipeline (embedding + rerank) has its own key and settings; it is not shared.
#
# A working DeepSeek configuration:
#   SUPERCODER_EXTERNAL_LLM_ENABLED=true
#   SUPERCODER_EXTERNAL_LLM_PROVIDER=deepseek
#   SUPERCODER_EXTERNAL_LLM_BASE_URL=https://api.deepseek.com
#   SUPERCODER_EXTERNAL_LLM_MODEL=deepseek-chat
#   (the LLM key variable is set from the host environment, never committed)
#
# The drafter emits a full manifest, which needs room for the JSON: 2048 tokens
# truncates it mid-object and the draft fails to parse. 4096 is the practical floor.
SUPERCODER_EXTERNAL_LLM_ENABLED=false
SUPERCODER_EXTERNAL_LLM_PROVIDER=disabled
SUPERCODER_EXTERNAL_LLM_BASE_URL=
SUPERCODER_EXTERNAL_LLM_MODEL=
SUPERCODER_LLM_API_KEY=
SUPERCODER_EXTERNAL_LLM_ALLOW_PROJECT_DATA=false
SUPERCODER_EXTERNAL_LLM_REQUEST_TIMEOUT_SECONDS=60
SUPERCODER_EXTERNAL_LLM_MAX_OUTPUT_TOKENS=2048
SUPERCODER_EXTERNAL_LLM_TEMPERATURE=0
